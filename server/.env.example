# Server Environment Variables Example
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Supabase Configuration
# IMPORTANT: Use service role key for admin operations on server-side
# NEVER commit or share the service role key!
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# For development fallback (uses anon key - NOT recommended for production)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Configuration
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com,another-admin@example.com

# Database (if using direct connection instead of Supabase)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
